# Node.js Express 服务器配置文件示例
# 复制此文件为 .env 并根据实际情况修改

# 环境模式
NODE_ENV=production

# 服务器配置
PORT=3001
HOST=127.0.0.1

# 文件上传配置
UPLOAD_DIR=/home/wwwroot/miniadwall/server/uploads
MAX_FILE_SIZE=52428800

# CORS 配置（跨域）
# 生产环境应该设置为具体的前端域名
CORS_ORIGIN=https://adwall.example.com

# 可选：数据库配置（如果需要）
# DATABASE_URL=mongodb://localhost:27017/miniadwall
# REDIS_URL=redis://localhost:6379

# 可选：日志配置
LOG_LEVEL=info
LOG_FILE=/var/log/miniadwall-api.log

# 可选：安全配置
JWT_SECRET=your_jwt_secret_key_here
API_KEY=your_api_key_here

# 可选：第三方服务
# ALIOSS_ENDPOINT=
# ALIOSS_ACCESS_KEY=
# ALIOSS_SECRET_KEY=

# 可选：邮件配置
# SMTP_HOST=
# SMTP_PORT=
# SMTP_USER=
# SMTP_PASSWORD=
